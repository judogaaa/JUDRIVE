FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt ./backend/requirements.txt
RUN --mount=type=secret,id=package_ca \
    if [ -f /run/secrets/package_ca ]; then export PIP_CERT=/run/secrets/package_ca; fi \
    && pip install --no-cache-dir -r backend/requirements.txt
COPY backend/app ./backend/app
COPY scripts/sqlite_snapshot.py ./scripts/sqlite_snapshot.py
COPY vendor/neurodvs_mock ./vendor/neurodvs_mock
ENV PYTHONPATH=/app/backend:/app/vendor/neurodvs_mock PYTHONUNBUFFERED=1
CMD ["python","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8090","--workers","1"]
