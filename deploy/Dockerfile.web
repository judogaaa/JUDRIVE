FROM node:22-bookworm-slim AS build
WORKDIR /ui
RUN --mount=type=bind,source=frontend,target=/source --mount=type=secret,id=package_ca \
    cp -R /source/. /ui/ \
    && if [ -f /run/secrets/package_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/package_ca; fi \
    && npm ci --cache /tmp/npm-cache \
    && npm run build \
    && rm -rf node_modules /tmp/npm-cache
FROM caddy:2
COPY --from=build /ui/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
