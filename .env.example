MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
FLEET_DATA_PATH=vendor/neurodvs_mock/data/vehicles.json
PDF_DIR=materials/manuals
DB_PATH=local-data/judrive.sqlite

# Только на backend (никогда в браузер / Git)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI-совместимый endpoint; меняется только для локального stub/шлюза
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_TOKENS=1200
GROQ_STT_MODEL=whisper-large-v3-turbo
AGENT_MAX_TOOL_STEPS=4

# Кабинет главного механика. Хеш: python scripts/hash_chief_password.py
# Не задавайте пароль в Git. COOKIE_SECURE=true только на HTTPS.
CHIEF_USERNAME=
CHIEF_PASSWORD_HASH=
SESSION_SECRET=
COOKIE_SECURE=false

# Необязательно: порт backend для Vite proxy и scripts/verify_agent_scenarios.py (по умолчанию 8090)
# JUDRIVE_BACKEND_PORT=8090

# Playwright: пароль главного механика (не коммитить). CHIEF_USERNAME берётся из .env.
# E2E_CHIEF_PASSWORD=
# Публичный HTTPS через compose.yaml (только домен без https://)
# JUDRIVE_DOMAIN=your-domain.example
