MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
FLEET_DATA_PATH=local-data/external/vehicles.json
# JUDRIVE_FLEET_DIR=/private/judrive/fleet
# JUDRIVE_MANUALS_DIR=/private/judrive/manuals
# JUDRIVE_STATE_DIR=/srv/judrive/state
# JUDRIVE_CA_DIR=/private/judrive/ca
# JUDRIVE_MANUALS_URL=   # ссылка из разрешённого комплекта, только локально
PDF_DIR=materials/manuals
DB_PATH=local-data/judrive.sqlite

# Только на backend (никогда в браузер / Git). Authorization Key из кабинета GigaChat API.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GigaChat-2-Max подходит для платных API-проектов; GigaChat-3-Ultra доступна только физлицам в freemium.
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_STT_MODEL=GigaChat-2-Max
GIGACHAT_MAX_TOKENS=1200
GIGACHAT_TIMEOUT_S=60
GIGACHAT_STT_TIMEOUT_S=90
# Необязательно: путь к доверенному CA bundle, если системного хранилища сертификатов недостаточно.
GIGACHAT_CA_BUNDLE=
AGENT_MAX_TOOL_STEPS=4
# Ноль отключает соответствующий лимит. Тарифы в микрорублях за токен.
# GIGACHAT_REQUEST_TOKENS=0
# GIGACHAT_REQUEST_BUDGET_MICRORUB=0
# GIGACHAT_DAILY_BUDGET_MICRORUB=0
# GIGACHAT_MONTHLY_BUDGET_MICRORUB=0
# GIGACHAT_CHAT_MICRORUB_PER_TOKEN=0
# GIGACHAT_VOICE_MICRORUB_PER_TOKEN=
# GIGACHAT_VOICE_RESERVE_TOKENS=128000
# CORS_ORIGINS=https://your-domain.example

# Кабинет главного механика. Хеш: python scripts/hash_chief_password.py
# Не задавайте пароль в Git. COOKIE_SECURE=true только на HTTPS.
CHIEF_USERNAME=
CHIEF_PASSWORD_HASH=
SESSION_SECRET=
COOKIE_SECURE=false

# Необязательно: порт backend для Vite proxy и scripts/verify_agent_scenarios.py (по умолчанию 8090)
# JUDRIVE_BACKEND_PORT=8090

# Стандартный Playwright создаёт свои учётные данные. Пароль нужен только для отдельного тестового стенда.
# E2E_CHIEF_PASSWORD=
# Публичный HTTPS через compose.yaml (только домен без https://)
# JUDRIVE_DOMAIN=your-domain.example
